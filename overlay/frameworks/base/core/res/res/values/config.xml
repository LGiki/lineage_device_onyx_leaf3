<resources>
    <!-- Leaf3 has no reliable hardware navigation keys. -->
    <bool name="config_showNavigationBar">true</bool>

    <!-- Keep wallpaper content unsupported: redrawing it behind launcher
         changes produces unnecessary grayscale E-Ink updates. The framework
         service must still run because Trebuchet calls its dimension APIs;
         Android 11's DisabledWallpaperManager returns null from those int
         methods and crashes the launcher while unboxing the result. -->
    <bool name="config_wallpaperSupported">false</bool>
    <bool name="config_enableWallpaperService">true</bool>

    <!-- E-Ink keeps its last image without power, so the bridge clears the
         panel on sleep. Doze and always-on would paint over that. -->
    <bool name="config_dozeAfterScreenOffByDefault">false</bool>
    <bool name="config_dozeAlwaysOnDisplayAvailable">false</bool>
    <bool name="config_dozeAlwaysOnEnabled">false</bool>
    <bool name="config_dozeSupportsAodWallpaper">false</bool>
    <string name="config_dozeComponent" translatable="false"></string>

    <!-- The frontlight is driven from the ONYX backlight nodes by the bridge,
         and no ambient light sensor feeds Android's own auto-brightness. -->
    <bool name="config_automatic_brightness_available">false</bool>

    <!-- Navigation scrims are gradients. The panel dithers them, which turns
         a status-bar change into a noisy grayscale update. -->
    <bool name="config_navBarNeedsScrim">false</bool>
</resources>

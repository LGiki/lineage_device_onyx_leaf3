<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/app_name"
        android:textColor="#000000"
        android:textSize="26sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/navigation"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:checkedButton="@id/nav_refresh"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <RadioButton
            android:id="@+id/nav_refresh"
            style="@style/Leaf3NavigationTab"
            android:text="@string/nav_refresh" />

        <RadioButton
            android:id="@+id/nav_tuning"
            style="@style/Leaf3NavigationTab"
            android:text="@string/nav_tuning" />

        <RadioButton
            android:id="@+id/nav_light"
            style="@style/Leaf3NavigationTab"
            android:text="@string/nav_light" />

        <RadioButton
            android:id="@+id/nav_status"
            style="@style/Leaf3NavigationTab"
            android:text="@string/nav_status" />
    </RadioGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#000000" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/page_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/Leaf3SectionTitle"
                android:text="@string/screen_refresh" />

            <TextView
                style="@style/Leaf3Description"
                android:layout_marginTop="4dp"
                android:text="@string/refresh_description" />

            <TextView
                style="@style/Leaf3Eyebrow"
                android:layout_marginTop="10dp"
                android:text="@string/refresh_tradeoff_header" />

            <RadioGroup
                android:id="@+id/refresh_modes"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/mode_balanced"
                    style="@style/Leaf3ModeChoice"
                    android:text="@string/balanced_explanation" />

                <RadioButton
                    android:id="@+id/mode_normal"
                    style="@style/Leaf3ModeChoice"
                    android:text="@string/normal_explanation" />

                <RadioButton
                    android:id="@+id/mode_speed"
                    style="@style/Leaf3ModeChoice"
                    android:text="@string/speed_explanation" />

                <RadioButton
                    android:id="@+id/mode_a2"
                    style="@style/Leaf3ModeChoice"
                    android:text="@string/a2_explanation" />

                <RadioButton
                    android:id="@+id/mode_regal"
                    style="@style/Leaf3ModeChoice"
                    android:text="@string/regal_explanation" />

                <RadioButton
                    android:id="@+id/mode_reader"
                    style="@style/Leaf3ModeChoice"
                    android:text="@string/reader_explanation" />
            </RadioGroup>

            <TextView
                style="@style/Leaf3Description"
                android:layout_marginTop="6dp"
                android:text="@string/global_refresh_description" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/full_refresh"
                    style="@style/Leaf3ActionButton"
                    android:layout_marginEnd="4dp"
                    android:text="@string/full_refresh" />

                <Button
                    android:id="@+id/per_app_profiles"
                    style="@style/Leaf3ActionButton"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:text="@string/per_app_profiles_short" />

                <Button
                    android:id="@+id/mode_specifications"
                    style="@style/Leaf3ActionButton"
                    android:layout_marginStart="4dp"
                    android:text="@string/mode_specifications_short" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/page_tuning"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:paddingStart="20dp"
              android:paddingTop="14dp"
              android:paddingEnd="20dp"
              android:paddingBottom="12dp">

            <TextView
                style="@style/Leaf3SectionTitle"
                android:text="@string/tuning_title" />

            <TextView
                style="@style/Leaf3Description"
                android:layout_marginTop="4dp"
                android:text="@string/tuning_description" />

            <TextView
                android:id="@+id/composer_limitations"
                style="@style/Leaf3Description"
                android:layout_marginTop="8dp"
                android:text="@string/composer_limitations"
                android:visibility="gone" />

            <TextView
                style="@style/Leaf3Eyebrow"
                android:layout_marginTop="14dp"
                android:text="@string/idle_capture" />

            <RadioGroup
                android:id="@+id/idle_policies"
                style="@style/Leaf3CompactChoiceGroup">

                <RadioButton
                    android:id="@+id/idle_responsive"
                    style="@style/Leaf3CompactChoice"
                    android:text="@string/idle_responsive_short" />

                <RadioButton
                    android:id="@+id/idle_balanced"
                    style="@style/Leaf3CompactChoice"
                    android:text="@string/idle_balanced_short" />

                <RadioButton
                    android:id="@+id/idle_battery"
                    style="@style/Leaf3CompactChoice"
                    android:text="@string/idle_battery_short" />
            </RadioGroup>

            <TextView
                style="@style/Leaf3Description"
                android:text="@string/idle_description" />

            <TextView
                style="@style/Leaf3Eyebrow"
                android:layout_marginTop="14dp"
                android:text="@string/ghost_cleanup" />

            <RadioGroup
                android:id="@+id/cleanup_policies"
                style="@style/Leaf3CompactChoiceGroup">

                <RadioButton
                    android:id="@+id/cleanup_quality"
                    style="@style/Leaf3CompactChoice"
                    android:text="@string/cleanup_quality_short" />

                <RadioButton
                    android:id="@+id/cleanup_balanced"
                    style="@style/Leaf3CompactChoice"
                    android:text="@string/cleanup_balanced_short" />

                <RadioButton
                    android:id="@+id/cleanup_manual"
                    style="@style/Leaf3CompactChoice"
                    android:text="@string/cleanup_manual_short" />
            </RadioGroup>

            <TextView
                style="@style/Leaf3Description"
                android:text="@string/cleanup_description_detailed" />

            <TextView
                style="@style/Leaf3Eyebrow"
                android:layout_marginTop="12dp"
                android:text="@string/reader_tuning" />

            <Spinner
                android:id="@+id/page_interval"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:entries="@array/page_interval_labels" />

            <Switch
                android:id="@+id/settled_quality"
                style="@style/Leaf3Switch"
                android:text="@string/settled_quality" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="#66000000" />

            <Switch
                android:id="@+id/disable_animations"
                style="@style/Leaf3Switch"
                android:text="@string/disable_animations" />

            <Switch
                android:id="@+id/scroll_detection"
                style="@style/Leaf3Switch"
                android:text="@string/scroll_detection" />

            <TextView
                style="@style/Leaf3ControlLabel"
                android:layout_marginTop="8dp"
                android:text="@string/sleep_screen" />

            <TextView
                style="@style/Leaf3Description"
                android:layout_marginTop="2dp"
                android:text="@string/sleep_screen_description" />

            <RadioGroup
                android:id="@+id/sleep_screen_modes"
                style="@style/Leaf3CompactChoiceGroup"
                android:checkedButton="@id/sleep_screen_clear">

                <RadioButton
                    android:id="@+id/sleep_screen_clear"
                    style="@style/Leaf3CompactChoice"
                    android:text="@string/sleep_screen_clear" />

                <RadioButton
                    android:id="@+id/sleep_screen_retain"
                    style="@style/Leaf3CompactChoice"
                    android:text="@string/sleep_screen_retain" />

                <RadioButton
                    android:id="@+id/sleep_screen_image"
                    style="@style/Leaf3CompactChoice"
                    android:text="@string/sleep_screen_image" />
            </RadioGroup>

            <Button
                android:id="@+id/choose_sleep_image"
                style="@style/Leaf3WideActionButton"
                android:layout_marginTop="2dp"
                android:text="@string/choose_sleep_image" />

            <Switch
                android:id="@+id/dither"
                style="@style/Leaf3Switch"
                android:text="@string/dither" />

            <TextView
                android:id="@+id/contrast_label"
                style="@style/Leaf3ControlLabel"
                android:layout_marginTop="6dp" />

            <SeekBar
                android:id="@+id/contrast"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:max="100"
                android:progress="50" />

            <TextView
                android:id="@+id/gamma_label"
                style="@style/Leaf3ControlLabel"
                android:layout_marginTop="4dp" />

            <SeekBar
                android:id="@+id/gamma"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:max="150"
                android:progress="50" />
          </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/page_light"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <TextView
                style="@style/Leaf3SectionTitle"
                android:text="@string/frontlight" />

            <TextView
                style="@style/Leaf3Description"
                android:layout_marginTop="4dp"
                android:text="@string/frontlight_description" />

            <Switch
                android:id="@+id/frontlight_enabled"
                style="@style/Leaf3Switch"
                android:layout_marginTop="10dp"
                android:text="@string/frontlight_enabled" />

            <Switch
                android:id="@+id/follow_android_brightness"
                style="@style/Leaf3Switch"
                android:text="@string/follow_android_brightness" />

            <TextView
                android:id="@+id/brightness_label"
                style="@style/Leaf3ControlLabel"
                android:layout_marginTop="12dp" />

            <SeekBar
                android:id="@+id/brightness"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:max="100"
                android:progress="50" />

            <TextView
                android:id="@+id/temperature_label"
                style="@style/Leaf3ControlLabel"
                android:layout_marginTop="8dp" />

            <SeekBar
                android:id="@+id/temperature"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:max="100"
                android:progress="0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/Leaf3Description"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/cool" />

                <TextView
                    style="@style/Leaf3Description"
                    android:layout_width="wrap_content"
                    android:text="@string/warm" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="#66000000" />

            <Switch
                android:id="@+id/grayscale"
                style="@style/Leaf3Switch"
                android:text="@string/grayscale" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/page_status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <TextView
                style="@style/Leaf3SectionTitle"
                android:text="@string/diagnostics" />

            <TextView
                style="@style/Leaf3Description"
                android:layout_marginTop="4dp"
                android:text="@string/diagnostics_description" />

            <TextView
                android:id="@+id/diagnostics"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="14dp"
                android:layout_weight="1"
                android:background="@drawable/panel_outline"
                android:fontFamily="monospace"
                android:gravity="top"
                android:padding="14dp"
                android:textColor="#000000"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <Button
                android:id="@+id/refresh_diagnostics"
                style="@style/Leaf3WideActionButton"
                android:layout_marginTop="12dp"
                android:text="@string/refresh_diagnostics" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>

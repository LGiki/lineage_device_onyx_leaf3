<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#000000"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/screen_refresh"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/refresh_description"
            android:textColor="#333333"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/global_refresh_description"
            android:textColor="#333333"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/refresh_modes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/mode_balanced"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/balanced"
                android:textColor="#000000"
                android:textSize="18sp" />

            <RadioButton
                android:id="@+id/mode_normal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/normal"
                android:textColor="#000000"
                android:textSize="18sp" />

            <RadioButton
                android:id="@+id/mode_speed"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/speed"
                android:textColor="#000000"
                android:textSize="18sp" />

            <RadioButton
                android:id="@+id/mode_a2"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/a2"
                android:textColor="#000000"
                android:textSize="18sp" />

            <RadioButton
                android:id="@+id/mode_regal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/regal"
                android:textColor="#000000"
                android:textSize="18sp" />
        </RadioGroup>

        <Button
            android:id="@+id/full_refresh"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/full_refresh"
            android:textSize="17sp" />

        <Button
            android:id="@+id/per_app_profiles"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/per_app_profiles"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/idle_capture"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/idle_description"
            android:textColor="#333333"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/idle_policies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/idle_responsive"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/idle_responsive"
                android:textColor="#000000"
                android:textSize="18sp" />

            <RadioButton
                android:id="@+id/idle_balanced"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/idle_balanced"
                android:textColor="#000000"
                android:textSize="18sp" />

            <RadioButton
                android:id="@+id/idle_battery"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/idle_battery"
                android:textColor="#000000"
                android:textSize="18sp" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/ghost_cleanup"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/cleanup_description"
            android:textColor="#333333"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/cleanup_policies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/cleanup_quality"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/cleanup_quality"
                android:textColor="#000000"
                android:textSize="18sp" />

            <RadioButton
                android:id="@+id/cleanup_balanced"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/cleanup_balanced"
                android:textColor="#000000"
                android:textSize="18sp" />

            <RadioButton
                android:id="@+id/cleanup_manual"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/cleanup_manual"
                android:textColor="#000000"
                android:textSize="18sp" />
        </RadioGroup>

        <Switch
            android:id="@+id/disable_animations"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:text="@string/disable_animations"
            android:textColor="#000000"
            android:textSize="18sp" />

        <Switch
            android:id="@+id/clear_on_sleep"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/clear_on_sleep"
            android:textColor="#000000"
            android:textSize="18sp" />

        <Switch
            android:id="@+id/grayscale"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/grayscale"
            android:textColor="#000000"
            android:textSize="18sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:background="#66000000" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/frontlight"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/frontlight_enabled"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/frontlight_enabled"
            android:textColor="#000000"
            android:textSize="18sp" />

        <Switch
            android:id="@+id/follow_android_brightness"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/follow_android_brightness"
            android:textColor="#000000"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/brightness_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#000000"
            android:textSize="18sp" />

        <SeekBar
            android:id="@+id/brightness"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:max="100"
            android:progress="50" />

        <TextView
            android:id="@+id/temperature_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="#000000"
            android:textSize="18sp" />

        <SeekBar
            android:id="@+id/temperature"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:max="100"
            android:progress="0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cool"
                android:textColor="#000000"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/warm"
                android:textColor="#000000"
                android:textSize="16sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:background="#66000000" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/diagnostics"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/diagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:textColor="#000000"
            android:textSize="15sp" />

        <Button
            android:id="@+id/refresh_diagnostics"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:text="@string/refresh_diagnostics"
            android:textSize="17sp" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="4dp">

    <TextView
        style="@style/Leaf3Description"
        android:text="@string/mode_specifications_intro" />

    <RadioGroup
        android:id="@+id/specification_modes"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/spec_balanced"
            style="@style/Leaf3SpecificationTab"
            android:text="@string/balanced" />

        <RadioButton
            android:id="@+id/spec_normal"
            style="@style/Leaf3SpecificationTab"
            android:text="@string/normal" />

        <RadioButton
            android:id="@+id/spec_speed"
            style="@style/Leaf3SpecificationTab"
            android:text="@string/speed" />

        <RadioButton
            android:id="@+id/spec_a2"
            style="@style/Leaf3SpecificationTab"
            android:text="@string/a2" />

        <RadioButton
            android:id="@+id/spec_regal"
            style="@style/Leaf3SpecificationTab"
            android:text="@string/regal" />
    </RadioGroup>

    <TextView
        android:id="@+id/specification_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/panel_outline"
        android:fontFamily="monospace"
        android:lineSpacingExtra="2dp"
        android:padding="14dp"
        android:textColor="#000000"
        android:textSize="14sp" />

    <TextView
        style="@style/Leaf3Description"
        android:layout_marginTop="12dp"
        android:text="@string/mode_specifications_shared" />
</LinearLayout>

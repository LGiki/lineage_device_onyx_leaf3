<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_refresh_mode"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/profile_mode"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:entries="@array/profile_mode_labels" />

        <Switch
            android:id="@+id/profile_override_contrast"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/profile_override_contrast"
            android:textColor="#000000"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/profile_contrast_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/profile_contrast"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:max="100" />

        <Switch
            android:id="@+id/profile_override_gamma"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/profile_override_gamma"
            android:textColor="#000000"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/profile_gamma_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/profile_gamma"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:max="150" />

        <Switch
            android:id="@+id/profile_override_dither"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/profile_override_dither"
            android:textColor="#000000"
            android:textSize="17sp" />

        <Switch
            android:id="@+id/profile_dither"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/dither"
            android:textColor="#000000"
            android:textSize="17sp" />

        <Switch
            android:id="@+id/profile_override_cleanup"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/profile_override_cleanup"
            android:textColor="#000000"
            android:textSize="17sp" />

        <Spinner
            android:id="@+id/profile_page_interval"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:entries="@array/profile_page_interval_labels" />

        <Switch
            android:id="@+id/profile_filter_animations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:text="@string/profile_filter_animations"
            android:textColor="#000000"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/profile_filter_animations_description"
            android:textColor="#444444"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>

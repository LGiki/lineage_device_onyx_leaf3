service leaf3-epdc-bridge /system_ext/bin/leaf3_epdc_bridge
    class late_start
    user system
    group graphics input
    task_profiles ProcessCapacityHigh HighPerformance
    disabled

on property:sys.boot_completed=1
    mkdir /data/misc/leaf3 0770 system system
    restorecon_recursive /data/misc/leaf3
    restorecon /dev/ebc
    chown system graphics /dev/ebc
    chmod 0660 /dev/ebc
    start leaf3-epdc-bridge

# The stock kernel moves ONYX PM to mem before attempting suspend. If suspend
# aborts (commonly because USB is connected), it does not restore the matching
# on state and Cypress remains asleep while Android is awake. Writing off is
# idempotent and makes the kernel deliver the missing mem-to-on notification.
on property:sys.leaf3.interactive=1
    write /sys/power/autosleep off

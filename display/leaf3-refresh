#!/system/bin/sh

mode_property=persist.sys.leaf3.refresh_mode
active_mode_property=sys.leaf3.active_refresh_mode
active_source_property=sys.leaf3.active_refresh_source
refresh_property=sys.leaf3.full_refresh
clear_on_sleep_property=persist.sys.leaf3.clear_on_sleep
idle_policy_property=persist.sys.leaf3.idle_policy
cleanup_policy_property=persist.sys.leaf3.cleanup_policy
content_aware_property=persist.sys.leaf3.content_aware
scroll_detect_property=persist.sys.leaf3.scroll_detect
capture_mode_property=persist.sys.leaf3.capture_mode
active_capture_mode_property=sys.leaf3.stat.capture_mode

usage() {
    echo "usage: leaf3-refresh {balanced|normal|speed|a2|regal|full|clear-on-sleep|retain-on-sleep|animations-off|animations-on|status}" >&2
    echo "       leaf3-refresh idle {responsive|balanced|battery}" >&2
    echo "       leaf3-refresh cleanup {quality|balanced|manual}" >&2
    echo "       leaf3-refresh content-aware off" >&2
    echo "       leaf3-refresh scroll-detect {on|off}" >&2
    echo "       leaf3-refresh capture poll" >&2
    exit 2
}

case "${1:-status}" in
    balanced|normal|speed|a2|regal)
        setprop "$mode_property" "$1"
        echo "Leaf3 global refresh mode: $1"
        ;;
    idle)
        case "${2:-}" in
            responsive|balanced|battery)
                setprop "$idle_policy_property" "$2"
                echo "Leaf3 idle capture policy: $2"
                ;;
            *)
                usage
                ;;
        esac
        ;;
    cleanup)
        case "${2:-}" in
            quality|balanced|manual)
                setprop "$cleanup_policy_property" "$2"
                echo "Leaf3 ghost-cleanup policy: $2"
                ;;
            *)
                usage
                ;;
        esac
        ;;
    content-aware)
        case "${2:-}" in
            off)
                setprop "$content_aware_property" 0
                echo "Leaf3 content-aware waveform selection: off"
                ;;
            on)
                echo "content-aware mode is quarantined because it overloads the vendor EBC path" >&2
                exit 1
                ;;
            *)
                usage
                ;;
        esac
        ;;
    scroll-detect)
        case "${2:-}" in
            on|off)
                [ "$2" = on ] && value=1 || value=0
                setprop "$scroll_detect_property" "$value"
                echo "Leaf3 scroll detection: $2"
                ;;
            *)
                usage
                ;;
        esac
        ;;
    capture)
        case "${2:-}" in
            poll)
                setprop "$capture_mode_property" "$2"
                echo "Leaf3 preferred capture source: $2"
                ;;
            stream)
                echo "The compositor stream is disabled on this vendor graphics stack" >&2
                exit 1
                ;;
            *)
                usage
                ;;
        esac
        ;;
    full)
        # Toggle the token so even consecutive requests are distinguishable.
        token="$(getprop "$refresh_property")"
        [ "$token" = "1" ] && token=0 || token=1
        setprop "$refresh_property" "$token"
        echo "Leaf3 full refresh requested"
        ;;
    clear-on-sleep)
        setprop "$clear_on_sleep_property" 1
        echo "Leaf3 will clear the retained frame while sleeping"
        ;;
    retain-on-sleep)
        setprop "$clear_on_sleep_property" 0
        echo "Leaf3 will retain the last frame while sleeping"
        ;;
    animations-off)
        settings put global window_animation_scale 0
        settings put global transition_animation_scale 0
        settings put global animator_duration_scale 0
        echo "Android animations disabled for E-Ink"
        ;;
    animations-on)
        settings put global window_animation_scale 1
        settings put global transition_animation_scale 1
        settings put global animator_duration_scale 1
        echo "Android animations restored"
        ;;
    status)
        mode="$(getprop "$mode_property")"
        active_mode="$(getprop "$active_mode_property")"
        active_source="$(getprop "$active_source_property")"
        clear_on_sleep="$(getprop "$clear_on_sleep_property")"
        idle_policy="$(getprop "$idle_policy_property")"
        cleanup_policy="$(getprop "$cleanup_policy_property")"
        content_aware="$(getprop "$content_aware_property")"
        scroll_detect="$(getprop "$scroll_detect_property")"
        capture_mode="$(getprop "$capture_mode_property")"
        active_capture_mode="$(getprop "$active_capture_mode_property")"
        case "$mode" in
            balanced|normal|speed|a2|regal) ;;
            *) mode=balanced ;;
        esac
        case "$active_mode" in
            balanced|normal|speed|a2|regal) ;;
            *) active_mode= ;;
        esac
        case "$idle_policy" in
            responsive|balanced|battery) ;;
            *) idle_policy=balanced ;;
        esac
        case "$cleanup_policy" in
            quality|balanced|manual) ;;
            *) cleanup_policy=balanced ;;
        esac
        effective_mode="${active_mode:-${mode:-balanced}}"
        content_aware=0
        [ "$scroll_detect" = 0 ] || scroll_detect=1
        capture_mode=poll
        echo "Leaf3 global refresh mode: $mode"
        echo "Active refresh override: ${active_mode:-none}"
        echo "Active refresh source: ${active_source:-default}"
        echo "Effective refresh mode: $effective_mode"
        echo "Preferred capture source: $capture_mode"
        echo "Active capture source: ${active_capture_mode:-starting}"
        echo "Idle polling fallback policy: $idle_policy"
        echo "Ghost-cleanup policy: $cleanup_policy"
        echo "Content-aware waveform selection: $content_aware"
        echo "Scroll detection: $scroll_detect"
        echo "Clear retained frame on sleep: ${clear_on_sleep:-1}"
        ;;
    *)
        usage
        ;;
esac
